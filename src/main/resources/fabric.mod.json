{
  "schemaVersion": 1,
  "id": "phasecraft",
  "version": "${version}",
  "name": "PhaseCraft",
  "description": "Experimental overlapping block layers for redstone machinery.",
  "authors": [
    "PhaseCraft contributors"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.phasecraft.PhaseCraft"
    ],
    "client": [
      "dev.phasecraft.client.PhaseCraftClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "phasecraft.mixins.json",
    {
      "config": "phasecraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "lithium:options": {
      "mixin.block.hopper": false
    }
  }
}
